#!/bin/sh
# Block commits containing secrets. Enable with: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks not installed (brew install gitleaks). Refusing to commit." >&2
    exit 1
fi
gitleaks git --staged --no-banner --redact --exit-code 1 .
