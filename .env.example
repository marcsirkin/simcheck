# SimCheck API keys — TEMPLATE ONLY. Never put real values in this file.
#
# Real keys go in ~/.config/simcheck/.env (outside the repo, chmod 600).
# Override that location with SIMCHECK_ENV_FILE=/path/to/file.
# Variables already set in the shell environment take precedence.

# OpenRouter: Claude explanations/escalation + LLM visibility probes.
# Set a credit limit on the key in the OpenRouter dashboard.
OPENROUTER_API_KEY=

# TypeSafe: Jev typed classifier (QRG rubric). Not available via OpenRouter.
TYPESAFE_API_KEY=
